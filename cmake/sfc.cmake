set(s9x "${WIZPLAYER_SNES9X_SOURCE}")
file(READ "${s9x}/libretro/Makefile.common" source_list)
string(REGEX MATCHALL "\\$\\(CORE_DIR\\)/[a-zA-Z0-9_./-]+\\.(cpp|c)" sources "${source_list}")
list(TRANSFORM sources REPLACE "\\$\\(CORE_DIR\\)" "${s9x}")
list(REMOVE_ITEM sources "${s9x}/memmap.cpp")

# The local core reads cartridge headers without calculating a ROM identity.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${s9x}/memmap.cpp")
file(READ "${s9x}/memmap.cpp" memmap)
string(FIND "${memmap}" "// CRC32\n" begin)
string(FIND "${memmap}" "// NTSC/PAL" end)
if(begin LESS 0 OR end LESS_EQUAL begin)
  message(FATAL_ERROR "Unexpected Snes9x ROM metadata implementation")
endif()
string(SUBSTRING "${memmap}" 0 ${begin} before)
string(SUBSTRING "${memmap}" ${end} -1 after)
set(memmap "${before}ROMCRC32 = 0;\n\tmemset(ROMSHA256, 0, sizeof(ROMSHA256));\n\t${after}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/snes-memmap.cpp.in" "${CMAKE_CURRENT_BINARY_DIR}/snes-memmap.cpp" @ONLY)

if(ANDROID)
  set(sfc_library_type SHARED)
else()
  set(sfc_library_type STATIC)
endif()
list(REMOVE_ITEM sources "${s9x}/cpuexec.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${s9x}/cpuexec.cpp")
file(READ "${s9x}/cpuexec.cpp" snes_cpuexec)
string(FIND "${snes_cpuexec}" "uint8\t\t\t\tOp;" hook_slot)
if(hook_slot LESS 0)
  message(FATAL_ERROR "Unexpected Snes9x CPU loop")
endif()
string(REPLACE "static inline void S9xReschedule (void);"
  "#define WIIZV_EXPORT\n#include \"wizardry_movement.inc\"\n#include \"wizardry_items.inc\"\n#include \"battle_rewards.inc\"\n#include \"wizardry_assists.inc\"\n\nstatic inline void S9xReschedule (void);"
  snes_cpuexec "${snes_cpuexec}")
string(REPLACE "uint8\t\t\t\tOp;" "wiizvMovementHook();\n\t\t\twizardryItemHook();\n\t\t\tsfcRewardHook();\n\t\t\twiizvEffectsHook();\n\t\t\tuint8\t\t\t\tOp;"
  snes_cpuexec "${snes_cpuexec}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/snes-cpuexec.cpp.in"
  "${CMAKE_CURRENT_BINARY_DIR}/snes-cpuexec.cpp" @ONLY)
list(APPEND sources "${CMAKE_CURRENT_BINARY_DIR}/snes-cpuexec.cpp")
add_library(wizplayer_sfc ${sfc_library_type} src/sfc/core.cpp ${sources}
  "${CMAKE_CURRENT_BINARY_DIR}/snes-memmap.cpp")
target_include_directories(wizplayer_sfc PRIVATE "${s9x}" "${s9x}/apu" "${s9x}/apu/bapu"
  "${s9x}/libretro" "${s9x}/libretro/libretro-common/include" src/sfc)
target_compile_definitions(wizplayer_sfc PRIVATE __LIBRETRO__ RIGHTSHIFT_IS_SAR HAVE_STDINT_H)
if(MSVC)
  target_compile_definitions(wizplayer_sfc PRIVATE __WIN32__ _CRT_SECURE_NO_WARNINGS strcasecmp=_stricmp strncasecmp=_strnicmp)
  target_compile_options(wizplayer_sfc PRIVATE /wd4244 /wd4267)
else()
  target_compile_definitions(wizplayer_sfc PRIVATE HAVE_STRINGS_H)
  target_compile_options(wizplayer_sfc PRIVATE "-ffile-prefix-map=${s9x}=snes9x")
endif()
if(ANDROID)
  target_link_options(wizplayer_sfc PRIVATE "-Wl,-z,max-page-size=16384")
endif()
