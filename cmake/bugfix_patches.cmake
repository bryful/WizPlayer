set(patch_root "${CMAKE_CURRENT_SOURCE_DIR}/.patch")
set(patch_header "#pragma once\n\n#include <string_view>\n\nnamespace builtInIps {\n")

function(embed_bugfix name platform filename)
  file(GLOB_RECURSE candidates CONFIGURE_DEPENDS "${patch_root}/${platform}/${filename}")
  list(LENGTH candidates count)
  if(count GREATER 1)
    message(FATAL_ERROR "More than one source IPS for ${name}")
  endif()
  set(hex "")
  if(count EQUAL 1)
    list(GET candidates 0 source)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" hex HEX)
  endif()
  string(LENGTH "${hex}" length)
  math(EXPR size "${length} / 2")
  string(REGEX REPLACE "(..)" "\\\\x\\1" escaped "${hex}")
  string(APPEND patch_header
    "inline constexpr std::string_view ${name}{\"${escaped}\", ${size}};\n")
  set(patch_header "${patch_header}" PARENT_SCOPE)
endfunction()

embed_bugfix(fcWizardry1 fc "wizardry_pg_fc_fix.ips")
embed_bugfix(gaiden1 gb "wizardry_soq(gaiden1)_fix.ips")
embed_bugfix(gaiden2 gb "wizardry_cae(gaiden2)_fix.ips")
embed_bugfix(gaiden3 gb "wizardry_sod(gaiden3)_fix.ips")
embed_bugfix(gbcWizardry1 gbc "Wizardry I - Kyouou no Shirenjyou (J)_fix.ips")
embed_bugfix(gbcWizardry2 gbc "Wizardry II - Llylgamyn no Isan (J)_fix.ips")
embed_bugfix(gbcWizardry3 gbc "Wizardry III - Diamond no Kishi (J)_fix.ips")
string(APPEND patch_header "}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/built_in_ips_data.h" CONTENT "${patch_header}")
